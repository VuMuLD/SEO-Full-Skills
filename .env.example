# SEO All-in-One — credentials template. EVERY key is optional.
#
# Copy to `.env` in the skill folder, in the folder where you run scripts, or to
# `~/.agentic-seo/.env`. Real environment variables win over .env; CLI flags win over both.
# Never paste secrets into a chat. Google/Moz/Bing helpers can also store keys via
# `python scripts/google_auth.py --setup` and `python scripts/backlinks_auth.py --setup`.

# --- Google (PageSpeed Insights, CrUX, Knowledge Graph, NLP, YouTube) ---------------
# console.cloud.google.com -> enable the APIs you need -> create an API key
GOOGLE_API_KEY=
PAGESPEED_API_KEY=
GOOGLE_KG_API_KEY=

# --- Google Search Console / Indexing API / GA4 (service account JSON) --------------
# Add the service account e-mail as a user (Owner for Indexing API) in Search Console.
GOOGLE_APPLICATION_CREDENTIALS=
GSC_CREDENTIALS_PATH=
GSC_PROPERTY=            # e.g. sc-domain:example.com or https://www.example.com/

# --- Backlink sources (free tiers) --------------------------------------------------
MOZ_API_KEY=
BING_WEBMASTER_API_KEY=
KEYWORDSEVERYWHERE_API_KEY=

# --- IndexNow (Bing, Yandex, Naver, Seznam, Yep) -------------------------------------
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=   # https://example.com/<key>.txt

# --- DataForSEO (paid, metered) ------------------------------------------------------
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# --- Matomo (self-hosted analytics) --------------------------------------------------
MATOMO_URL=
MATOMO_TOKEN=
MATOMO_SITE_ID=

# --- GitHub repository SEO -----------------------------------------------------------
GITHUB_TOKEN=            # or run `gh auth login`

# --- Image generation (Gemini via nanobanana MCP or scripts/image_gen) ---------------
GOOGLE_AI_API_KEY=
NANOBANANA_MODEL=

# --- Auditing localhost / private staging hosts (only hosts you control) -------------
# CLAUDE_SEO_LOCAL_TARGETS=localhost:3000,127.0.0.1:8080
